# PostgreSQL database (Prisma Postgres on Vercel or another PostgreSQL provider).
# Use the provider's DATABASE_URL. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Use a stable random secret in every Vercel environment, e.g. openssl rand -hex 32.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
